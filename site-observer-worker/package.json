{
  "name": "site-observer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --strict-vars false --env-file .dev.vars.example",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir .wrangler-check",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply site-observer-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply site-observer-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
