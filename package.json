{
  "name": "my-remix-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:worker": "npm run build && wrangler dev",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "fonts:build": "python scripts/build-font-subsets.py --download",
    "lyrics:build": "node scripts/build-lyrics.mjs",
    "build-log:stats": "node scripts/build-log-stats.mjs",
    "i18n:extract": "formatjs extract \"app/**/*.{ts,tsx}\" --ignore \"app/**/*.d.ts\" --out-file app/locales/zh.json --id-interpolation-pattern \"[sha512:contenthash:base64:6]\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "cf:login": "wrangler login",
    "deploy": "npm run build && wrangler deploy",
    "stickers:prepare": "node scripts/prepare-nemesis-stickers.mjs",
    "stickers:upload": "node scripts/upload-nemesis-stickers.mjs",
    "music:sync": "node scripts/sync-nemesis-music.mjs",
    "music:verify": "node scripts/verify-nemesis-music.mjs",
    "nemesis:eval": "node scripts/eval-nemesis.mjs",
    "images:fetch": "node scripts/fetch-image-sources.mjs",
    "images:process": "node scripts/process-images.mjs",
    "images:upload": "node scripts/upload-public-images.mjs",
    "images:pipeline": "npm run images:fetch && npm run images:process && npm run images:upload",
    "d1:migrate:local": "wrangler d1 migrations apply app-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply app-db --remote"
  },
  "dependencies": {
    "better-auth": "^1.3.34",
    "framer-motion": "^12.18.1",
    "gsap": "^3.15.0",
    "isbot": "^4.1.0",
    "kysely": "^0.27.4",
    "kysely-d1": "^0.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^12.1.4",
    "react-router": "~7.18.4",
    "resend": "^6.12.4",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260228.0",
    "@formatjs/cli": "^6.16.34",
    "@formatjs/unplugin": "^1.2.13",
    "@react-router/dev": "~7.18.4",
    "@react-router/fs-routes": "~7.18.4",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.1.6",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
