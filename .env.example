# ====================================
# App Runtime
# ====================================
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
LOCAL_APP_URL=http://localhost:3000
APP_NAME=MyRemixApp

# ====================================
# Media Token Signing
# ====================================
# Required for /api/image-token and /api/verify-token
AUTH_KEY_SECRET=replace_with_a_strong_random_secret
BETTER_AUTH_SECRET=replace_with_a_strong_random_secret
IMAGE_BASE_URL=https://oss.example.com

# ====================================
# Better Auth - Google OAuth
# ====================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ====================================
# Better Auth - Microsoft OAuth
# ====================================
MICROSOFT_AUTH_BASE_URL=https://my-remix-worker.your-subdomain.workers.dev
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_REDIRECT_URI=https://my-remix-worker.your-subdomain.workers.dev/api/auth/callback/microsoft

# ====================================
# Email (Resend)
# ====================================
# In development, email sending can run without RESEND_API_KEY.
# In production, configure both values.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@example.com

# ====================================
# Nemesis / Gemini
# ====================================
# Set production value with Wrangler:
#   wrangler secret put GOOGLE_AI_API_KEY
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# Grok: configure xAI in AI Gateway Provider Keys + CF_AIG_TOKEN (no Worker secret needed).
# XAI_API_KEY=
NEMESIS_GEMINI_MODEL=gemini-3.5-flash-lite
NEMESIS_GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Emergency manual override only (free tier is very limited). Normal traffic uses Lite + DeepSeek fallback.
NEMESIS_GEMINI_FLASH_MODEL=gemini-3.5-flash
NEMESIS_GEMINI_THINKING_LEVEL=high
NEMESIS_DEEPSEEK_MODEL=deepseek-v4-flash
NEMESIS_GROK_MODEL=grok-4.3
# Optional: Gemini JSON guard classifier model (defaults to NEMESIS_GEMINI_LITE_MODEL)
# NEMESIS_CLASSIFIER_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override: gemini_lite (default), grok_complex, grok_roast, deepseek, gemini_flash (manual only)
NEMESIS_MODEL_ROUTE=
# Route all Nemesis providers through Cloudflare AI Gateway (dashboard name, e.g. my-ai-gateway).
# Leave empty to call Google generativelanguage.googleapis.com directly.
NEMESIS_AI_GATEWAY_ID=my-ai-gateway
# DeepSeek BYOK alias is "deepseek" (Grok/Google use dashboard "default" — no header needed).
# NEMESIS_AIG_BYOK_ALIAS_DEEPSEEK=deepseek
# Optional: only if the gateway has Authenticated Gateway enabled.
# wrangler secret put CF_AIG_TOKEN
# CF_AIG_TOKEN=
# Optional fallback when env.AI.gateway().getUrl is unavailable in dev:
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
NEMESIS_MAX_PER_MINUTE=5
NEMESIS_MAX_PER_DAY=50
NEMESIS_MAX_MESSAGE_LENGTH=1000

# ====================================
# Admin Settings
# ====================================
# Comma-separated list
ADMIN_EMAILS=admin@example.com
ADMIN_MESSAGES_URL=https://admin.xn--cckl9nsb.com/
# Comma-separated public IPs allowed to call the message moderation API.
MESSAGE_MODERATION_ALLOWED_IPS=127.0.0.1,::1
# HTTPS endpoint for passive guestbook notifications delivered by Hermes.
MESSAGE_NOTIFICATION_WEBHOOK_URL=https://example.com/webhooks/guestbook-notification
# Store the production value with `wrangler secret put`; never commit it.
MESSAGE_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-random-secret

# ====================================
# Cloudflare Worker + D1 Notes
# ====================================
# 1) Configure [[d1_databases]] in wrangler.toml with your real database_id.
# 2) Run: npm run d1:migrate:local
# 3) For remote: npm run d1:migrate:remote
# 4) Set production secrets with Wrangler:
#    wrangler secret put AUTH_KEY_SECRET
#    wrangler secret put RESEND_API_KEY
#    wrangler secret put GOOGLE_AI_API_KEY
#    wrangler secret put DEEPSEEK_API_KEY
#    wrangler secret put XAI_API_KEY
#    wrangler secret put GOOGLE_CLIENT_SECRET
#    wrangler secret put MICROSOFT_CLIENT_SECRET
